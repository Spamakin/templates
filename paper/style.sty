% ---- THEOREM & LEMMA ENVIRONMENTS ----
% TODO: unnumbered versions

\declaretheoremstyle[
    spaceabove=\topsep,
    spacebelow=\topsep,
    headindent=0pt,
    headfont=\bfseries,
    postheadhook = {\hspace*{\parindent}},
    postheadspace=0pt plus 1pt minus 1pt,
    headpunct=:,
    notefont=\bfseries\boldmath,
    bodyfont=\normalfont
]{theorem}

\declaretheorem[style=theorem, numberwithin=section, name=Definition]{defn}
